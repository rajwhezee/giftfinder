# Get this from your Neon project dashboard -> Connect (use the pooled connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Etsy Open API v3 (scripts/import-etsy.ts) ---
# Both values come from https://www.etsy.com/developers/your-apps
# v3 sends them together as one header: x-api-key: <keystring>:<shared_secret>
# Server-side only (never NEXT_PUBLIC_) — used by the batch import script, never
# by the browser. PUT THE REAL VALUES IN .env — this file is committed to git.
ETSY_KEYSTRING=""
ETSY_SHARED_SECRET=""

# --- Best Buy Products API (scripts/import-bestbuy.ts) ---
# Free key from https://developer.bestbuy.com/ — no affiliate membership needed.
# Server-side only (never NEXT_PUBLIC_): used by the batch import script.
# PUT THE REAL VALUE IN .env — this file is committed to git.
BESTBUY_API_KEY=""

# --- eBay Browse API (scripts/import-ebay.ts) ---
# Create a Production keyset at https://developer.ebay.com/my/keys — the page
# stays locked until you subscribe to or opt out of eBay's marketplace account
# deletion notifications (opt out: we store listings, never eBay user data).
# These are NOT the affiliate campid below: Browse needs an OAuth application
# token minted from this pair via the client credentials grant, so they are
# server-side only and must never be NEXT_PUBLIC_.
# App ID / Client ID:
EBAY_CLIENT_ID=""
# Cert ID / Client Secret:
EBAY_CLIENT_SECRET=""

# --- Affiliate tracking IDs (lib/affiliate.ts) ---
# These are NEXT_PUBLIC_ because the affiliate link is built client-side in GiftCard.
# Safe placeholder values are used automatically if these are unset, so the app
# works out of the box before you have real affiliate accounts.

# Amazon Associates tracking ID ("Store ID"), e.g. "yourname-20".
# Get it from: Amazon Associates dashboard -> Account Settings.
NEXT_PUBLIC_AMAZON_TAG="giftfinder-20"

# eBay Partner Network Campaign ID (a numeric string).
# Get it from: eBay Partner Network dashboard -> Campaigns/Links.
NEXT_PUBLIC_EBAY_CAMPID="0000000000"

# Awin publisher (affiliate) ID — shared across every merchant you're approved
# for on the Awin network, including Etsy.
# Get it from: Awin dashboard -> Account -> top-right, or any Awin link builder.
NEXT_PUBLIC_AWIN_AFFILIATE_ID="000000"

# Awin merchant ID specific to Etsy's affiliate program within Awin.
# Get it from: Awin dashboard -> Programmes -> search "Etsy" -> Programme details.
NEXT_PUBLIC_AWIN_ETSY_MERCHANT_ID="00000"

# Walmart runs its affiliate program through Impact. These two IDs come from
# the deep-link template Impact generates once your Walmart application is
# approved (Impact dashboard -> Walmart program -> "Get Links"). The exact
# link shape can vary by program, so confirm it matches lib/affiliate.ts
# before relying on it in production.
NEXT_PUBLIC_IMPACT_WALMART_ACCOUNT_ID="0000000"
NEXT_PUBLIC_IMPACT_WALMART_CAMPAIGN_ID="0000000"
