# Get this from your Neon project dashboard -> Connect (use the pooled connection string)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Etsy Open API v3 (scripts/import-etsy.ts) ---
# Both values come from https://www.etsy.com/developers/your-apps
# v3 sends them together as one header: x-api-key: <keystring>:<shared_secret>
# Server-side only (never NEXT_PUBLIC_) — used by the batch import script, never
# by the browser. PUT THE REAL VALUES IN .env — this file is committed to git.
ETSY_KEYSTRING=""
ETSY_SHARED_SECRET=""

# --- Best Buy Products API (scripts/import-bestbuy.ts) ---
# Free key from https://developer.bestbuy.com/ — no affiliate membership needed.
# Server-side only (never NEXT_PUBLIC_): used by the batch import script.
# PUT THE REAL VALUE IN .env — this file is committed to git.
BESTBUY_API_KEY=""

# --- eBay Browse API (scripts/import-ebay.ts) ---
# Create a Production keyset at https://developer.ebay.com/my/keys — the page
# stays locked until you subscribe to or opt out of eBay's marketplace account
# deletion notifications (opt out: we store listings, never eBay user data).
# Browse needs an OAuth application token minted from this pair via the client
# credentials grant, so they are server-side only and must never be
# NEXT_PUBLIC_. eBay's affiliate campaign id is deliberately not set anywhere —
# Browse works as a plain product API without it.
# App ID / Client ID:
EBAY_CLIENT_ID=""
# Cert ID / Client Secret:
EBAY_CLIENT_SECRET=""

# --- Anthropic API (scripts/enrich-tags.ts) ---
# Create a key at https://console.anthropic.com -> API Keys, and add a billing
# balance — the API is prepaid and separate from any Claude subscription, so an
# unfunded account fails on insufficient credit rather than on a bad key.
#
# Used only by the offline tagging pass, never at request time: /api/recommend
# stays a plain Postgres query. Server-side only — never NEXT_PUBLIC_, or the
# key ships to every browser.
ANTHROPIC_API_KEY=""

# No affiliate credentials are needed. Every source here is a plain developer
# API or public endpoint: Etsy and eBay issue free keys, Best Buy explicitly
# requires no affiliate membership, and Shopify storefronts are public. Links
# go straight to the merchant, untracked and unwrapped.
