// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gift {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  imageUrl      String
  /// The merchant's own product page. Mapped to the legacy `affiliateUrl`
  /// column so renaming it in code needed no migration — the site never joined
  /// an affiliate programme, so the old name only ever described an intention.
  productUrl    String   @unique @map("affiliateUrl")
  platform      String
  occasions     String[]
  interests     String[]
  ageMin        Int
  ageMax        Int
  /// "male" | "female" | "unisex" — who the product is marketed for
  gender        String   @default("unisex")
  /// Original listing currency; price is stored in USD (converted at import
  /// time when this isn't "USD"), and the UI shows converted prices as "~$x".
  currency      String   @default("USD")
  /// 0-100: how well this reads as something a person would enjoy unwrapping,
  /// as opposed to a useful purchase. Written by scripts/score-gifts.ts, an
  /// offline Claude pass; null means unscored, which ranking treats as neutral
  /// so a partial run never penalises rows that were never looked at.
  giftScore     Int?
  /// What the thing *is* — "Keyboards", "Candles", "Shoes" — as opposed to who
  /// it suits, which is `interests`. Derived by lib/product-tags.ts at import
  /// time. Null where no rule matched, which the UI groups as "Everything else".
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([occasions], type: Gin)
  @@index([interests], type: Gin)
  @@index([category])
}
