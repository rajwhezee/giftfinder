// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gift {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Decimal  @db.Decimal(10, 2)
  imageUrl      String
  /// The merchant's own product page. Mapped to the legacy `affiliateUrl`
  /// column so renaming it in code needed no migration — the site never joined
  /// an affiliate programme, so the old name only ever described an intention.
  productUrl    String   @unique @map("affiliateUrl")
  platform      String
  occasions     String[]
  interests     String[]
  ageMin        Int
  ageMax        Int
  /// "male" | "female" | "unisex" — who the product is marketed for
  gender        String   @default("unisex")
  /// Original listing currency; price is stored in USD (converted at import
  /// time when this isn't "USD"), and the UI shows converted prices as "~$x".
  currency      String   @default("USD")
  /// 0-100: how well this reads as something a person would enjoy unwrapping,
  /// as opposed to a useful purchase. Written by scripts/score-gifts.ts, an
  /// offline Claude pass; null means unscored, which ranking treats as neutral
  /// so a partial run never penalises rows that were never looked at.
  giftScore     Int?
  /// What the thing *is* — "Keyboards", "Candles", "Shoes" — as opposed to who
  /// it suits, which is `interests`. Derived by lib/product-tags.ts at import
  /// time. Null where no rule matched, which the UI groups as "Everything else".
  category      String?
  /// Who made it, when that differs from where it is sold. `platform` is the
  /// brand for the ~140 Shopify storefronts, so this stays null for them and
  /// the UI falls back. It exists for eBay, whose rows would otherwise all read
  /// "eBay" on a card and in the brand filter; lib/brand-from-title.ts derives
  /// it. Null means no brand was recognised, which for a white-label air fryer
  /// is the correct answer rather than a gap.
  brand         String?
  /// False when the merchant's CDN no longer serves `imageUrl`. Every photo is
  /// hotlinked, so these rot on the merchant's schedule: a sweep on 2026-09-07
  /// found 26 of 29,582 dead, products still listed in the feed pointing at an
  /// image their own CDN 404s. Written by scripts/check-images.ts; ranking
  /// demotes these below everything that has a picture, so a shopper only meets
  /// one after exhausting the real matches.
  imageOk       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([occasions], type: Gin)
  @@index([interests], type: Gin)
  @@index([category])
  @@index([brand])
}

/// A suggestion left through /feedback, replacing the Google Form the site
/// used during testing.
///
/// Deliberately carries no IP address, no user agent and no session id. Rate
/// limiting needs to recognise a repeat submitter, but it does not need to know
/// which message they sent, so that lives in SubmissionThrottle instead and
/// nothing joins the two. What a person wrote and where they wrote it from are
/// never stored on the same row.
model Suggestion {
  id        String   @id @default(cuid())
  /// "suggestion" | "bug" | "missing" | "other" — see FEEDBACK_KINDS.
  kind      String   @default("suggestion")
  message   String
  /// Only if they chose to leave one, and only so a reply is possible.
  email     String?
  /// The page they were on. Answers "was this from a results grid or a landing
  /// page", which is most of what makes a suggestion actionable.
  path      String?
  /// Set by hand once it has been read and acted on. No admin UI: see
  /// scripts/read-feedback.ts.
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([handled])
}

/// One row per accepted submission, holding a salted hash of the sender's IP
/// and nothing else. Exists only so /api/feedback can count recent posts from
/// the same source and refuse the fifth in an hour.
///
/// Truncated SHA-256 over a salt plus the address. That is not a strong
/// anonymisation — the IPv4 space is small enough to brute force given the
/// salt — it is a way of not keeping a plaintext address for a spam counter.
/// Pruned by scripts/read-feedback.ts --prune.
model SubmissionThrottle {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
